# syntax=docker/dockerfile:1.10
# AfricAir front end: static dist/ served by unprivileged nginx (UID 101, port 8080), which also proxies /api/.
# Build: docker buildx build -f Dockerfile.web --build-arg VERSION=1.0.0 --build-arg GIT_SHA=$(git rev-parse HEAD) \
#          --build-arg BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) -t africair-web .

ARG NODE_IMAGE=node:22.23.4-alpine
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.8-alpine

# --- deps: only the manifests, so this layer is cached until a lockfile changes -------------------
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
ENV PNPM_HOME=/pnpm CI=true
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json server/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile

# --- test: the image cannot be built if type checks or tests fail --------------------------------
FROM deps AS test
COPY . .
RUN pnpm check && pnpm test

# --- build: FROM test, so BuildKit can never skip the test stage ---------------------------------
FROM test AS build
ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
RUN pnpm build \
 && node -e 'const [commit, version, builtAt] = process.argv.slice(1); process.stdout.write(JSON.stringify({ commit, version, builtAt }) + "\n")' \
      "$GIT_SHA" "$VERSION" "$BUILD_DATE" > dist/version.json

# --- runtime: nginx and the static files only; no Node, no source --------------------------------
FROM ${NGINX_IMAGE} AS runtime
ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="africair-web" \
      org.opencontainers.image.description="AfricAir static front end on unprivileged nginx" \
      org.opencontainers.image.source="https://github.com/CHAFAH/AfricAir" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}"

USER root
# Security updates from the image's own Alpine release: the upstream tag is rebuilt less often than
# Alpine publishes fixes (Trivy found 47 fixed HIGH CVEs in 1.29.8-alpine). The stock default.conf is
# removed; ours is rendered from the templates.
RUN apk upgrade --no-cache \
 && rm -f /etc/nginx/conf.d/default.conf
COPY deploy/docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --chmod=0755 deploy/docker/nginx/05-prepare-tmp.sh /docker-entrypoint.d/05-prepare-tmp.sh
COPY deploy/nginx/templates/ /etc/nginx/templates/
COPY --from=build /app/dist/ /usr/share/nginx/html/
USER 101

# Templates are rendered into /tmp (an emptyDir / tmpfs), so the root filesystem can be read-only.
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS makes the entrypoint export NGINX_LOCAL_RESOLVERS from /etc/resolv.conf
# (127.0.0.11 under Docker, the cluster DNS in Kubernetes) for the `resolver` directive.
ENV NGINX_ENVSUBST_OUTPUT_DIR=/tmp/nginx-conf \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 \
    API_UPSTREAM=http://api:4000 \
    APP_ENV=local

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
