# syntax=docker/dockerfile:1.7

FROM node:22.14.0-alpine3.21 AS deps

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json server/package.json

RUN --mount=type=cache,id=africair-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile

FROM deps AS test

COPY . .

RUN pnpm check && pnpm test

FROM test AS build

ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown

RUN pnpm build && \
    printf '{\n  "version": "%s",\n  "commit": "%s",\n  "builtAt": "%s"\n}\n' \
      "$VERSION" "$GIT_SHA" "$BUILD_DATE" > dist/version.json

FROM nginxinc/nginx-unprivileged:alpine-slim@sha256:a8cb0f33d51fa107c96fd2bd3a71aaf564ec131e9d2bdf8700944f0ed8b170d7 AS runtime

ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/Joketech/AfricAir

LABEL org.opencontainers.image.title="AfricAir web" \
      org.opencontainers.image.description="AfricAir static frontend and API reverse proxy" \
      org.opencontainers.image.revision="$GIT_SHA" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.created="$BUILD_DATE" \
      org.opencontainers.image.source="$SOURCE_URL"

ENV API_UPSTREAM=http://api:4000 \
    APP_ENV=production \
    NGINX_ENVSUBST_OUTPUT_DIR=/tmp \
    NGINX_ENVSUBST_FILTER='^(API_UPSTREAM|APP_ENV)$'

COPY --from=build --chown=101:101 /app/dist/ /usr/share/nginx/html/
COPY --chown=101:101 deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --chown=101:101 deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template

USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
