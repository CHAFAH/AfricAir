# syntax=docker/dockerfile:1.7

FROM node:22-alpine@sha256:ce8d97f7cfc7c5386421eb932df20a29df99b1a7f469f6157d5c9956702ffadc AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json server/package.json

RUN --mount=type=cache,id=africair-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile

COPY . .

RUN pnpm build:api

FROM build AS prod-deps

RUN pnpm --filter @africair/api --prod deploy /prod/api && \
    for package in typescript vite react react-dom tsx; do \
      test ! -e "/prod/api/node_modules/$package" || \
        { echo "unexpected non-production package: $package" >&2; exit 1; }; \
    done

FROM node:22-alpine@sha256:ce8d97f7cfc7c5386421eb932df20a29df99b1a7f469f6157d5c9956702ffadc AS runtime

ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/Joketech/AfricAir

LABEL org.opencontainers.image.title="AfricAir API" \
      org.opencontainers.image.description="AfricAir runtime configuration, bookings, and metrics API" \
      org.opencontainers.image.revision="$GIT_SHA" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.created="$BUILD_DATE" \
      org.opencontainers.image.source="$SOURCE_URL"

ENV NODE_ENV=production \
    PORT=4000 \
    METRICS_PORT=9464

WORKDIR /app

COPY --from=prod-deps --chown=node:node /prod/api/package.json ./package.json
COPY --from=prod-deps --chown=node:node /prod/api/node_modules/ ./node_modules/
COPY --from=build --chown=node:node /app/server/dist/ ./dist/
COPY --from=build --chown=node:node /app/server/migrations/ ./migrations/

RUN rm -rf \
      /usr/local/lib/node_modules/npm \
      /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/corepack \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg \
      /usr/local/bin/pnpm \
      /usr/local/bin/pnpx

USER node

EXPOSE 4000 9464

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/api/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
