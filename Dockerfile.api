# syntax=docker/dockerfile:1

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS build

RUN corepack enable

WORKDIR /app

# Copy manifests first for layer-cache efficiency
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY server/ ./server/

RUN pnpm build:api

# ── Stage 2: prod-deps ────────────────────────────────────────────────────────
FROM node:22-alpine AS prod-deps

WORKDIR /prod

# Copy only the API manifest — no workspace context, so only pg + prom-client install
COPY server/package.json ./package.json

RUN npm install --omit=dev --ignore-scripts

# ── Stage 3: runtime ──────────────────────────────────────────────────────────
# Distroless Node 22 (nonroot tag, digest-pinned for reproducibility):
# no shell, no package manager, runs as uid 65532 by default.
FROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:13593b7570658e8477de39e2f4a1dd25db2f836d68a0ba771251572d23bb4f8e AS runtime

LABEL org.opencontainers.image.source="https://github.com/engineerkg/AfricAir" \
      org.opencontainers.image.revision="" \
      org.opencontainers.image.version="" \
      org.opencontainers.image.created=""

WORKDIR /app

COPY --from=prod-deps /prod/node_modules ./node_modules
COPY --from=build     /app/server/dist   ./dist
COPY --from=build     /app/server/migrations ./migrations
COPY server/package.json ./

# the :nonroot tag already runs as uid 65532, but set it explicitly for clarity
USER nonroot

EXPOSE 4000 9464

# distroless has no shell, so the healthcheck is exec-form and runs node directly.
# Inline script GETs 127.0.0.1:4000/api/healthz and exits 0 on 200, 1 otherwise.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "require('http').get('http://127.0.0.1:4000/api/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]

# Base image ENTRYPOINT is ["/nodejs/bin/node"]; CMD supplies the script path.
CMD ["dist/index.js"]
