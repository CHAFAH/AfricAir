APP_ENV=staging
APP_VERSION=1.0.0
BRAND_NAME=AfricAir Staging
ANNOUNCEMENT_TEXT=You are on the Docker Compose staging stack
ANNOUNCEMENT_LEVEL=warning
SERVICE_FEE_USD=5
DEFAULT_CURRENCY=NGN
SECRET_REFRESH_SECONDS=10
EXPOSE_SECRET_FINGERPRINTS=true
ADMIN_TOKEN_FILE=/run/secrets/admin_token
PROMO_CODES_FILE=/run/secrets/promo_codes
PGHOST=db
PGPORT=5432
PGDATABASE=africair
PGUSER=africair_app
PGPASSWORD_FILE=/run/secrets/db_password
LOG_LEVEL=info
SHUTDOWN_DELAY_MS=5000
