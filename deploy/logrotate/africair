# /etc/logrotate.d/africair
/var/log/nginx/africair.access.json {
  daily
  rotate 14
  compress
  delaycompress
  missingok
  notifempty
  create 0640 www-data adm
  sharedscripts
  postrotate
    # USR1 makes nginx reopen its log files without dropping connections.
    [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
  endscript
}
