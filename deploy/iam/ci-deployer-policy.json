{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLoginAndFindCluster",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken", "eks:DescribeCluster"],
      "Resource": "*"
    },
    {
      "Sid": "PushImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer", "ecr:InitiateLayerUpload", "ecr:PutImage", "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:${region}:${account_id}:repository/africair-web",
        "arn:aws:ecr:${region}:${account_id}:repository/africair-api"
      ]
    }
  ],
  "_kubernetes": "Kubernetes rights come from an EKS access entry: AmazonEKSEditPolicy in namespace africair-staging (terraform/ci.tf)."
}
