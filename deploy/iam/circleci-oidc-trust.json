{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CircleCiMainBranchOnly",
      "Effect": "Allow",
      "Principal": { "Federated": "arn:aws:iam::${account_id}:oidc-provider/oidc.circleci.com/org/${circleci_org_id}" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": { "oidc.circleci.com/org/${circleci_org_id}:aud": "${circleci_org_id}" },
        "StringLike": {
          "oidc.circleci.com/org/${circleci_org_id}:sub": "org/${circleci_org_id}/project/${circleci_project_id}/user/*/vcs-origin/*/vcs-ref/refs/heads/main"
        }
      }
    }
  ]
}
