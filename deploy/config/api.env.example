# /etc/africair/api.env: API settings only (root:africair 0640). Never put secrets here:
# they live in /etc/africair/secrets/ and reach the service through LoadCredential=.
APP_ENV=staging
APP_VERSION=1.0.0
ANNOUNCEMENT_TEXT=Welcome to the AfricAir staging server
ANNOUNCEMENT_LEVEL=info
SERVICE_FEE_USD=9
DEFAULT_CURRENCY=KES
MAINTENANCE_MODE=false
SUPPORT_EMAIL=support@africair.example
SECRET_REFRESH_SECONDS=10
SHUTDOWN_DELAY_MS=5000
LOG_LEVEL=info
