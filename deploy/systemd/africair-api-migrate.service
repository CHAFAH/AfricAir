[Unit]
Description=Apply AfricAir PostgreSQL migrations
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=africair
Group=africair
WorkingDirectory=/opt/africair/api/current
EnvironmentFile=/etc/africair/api.env
LoadCredential=database_url:/etc/africair/secrets/database_url
Environment=DATABASE_URL_FILE=%d/database_url
ExecStart=/usr/bin/node /opt/africair/api/current/server/dist/migrate.js
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M
