[Unit]
Description=AfricAir database migrations (one-shot, run by deploy.sh before the API restarts)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=africair
Group=africair
WorkingDirectory=/opt/africair/api/current
EnvironmentFile=/etc/africair/api.env
LoadCredential=database_url:/etc/africair/secrets/database_url
Environment=NODE_ENV=production DATABASE_URL_FILE=%d/database_url
ExecStart=/usr/bin/node dist/migrate.js
TimeoutStartSec=120

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
InaccessiblePaths=/etc/africair/secrets
MemoryMax=256M
