[Unit]
Description=AfricAir API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=africair
WorkingDirectory=/opt/africair/current
ExecStart=/usr/bin/node server/dist/index.js
Restart=on-failure
RestartSec=5s

EnvironmentFile=/etc/africair/api.env
Environment=ADMIN_TOKEN_FILE=%d/admin_token
Environment=PROMO_CODES_FILE=%d/promo_codes
Environment=DATABASE_URL_FILE=%d/database_url

LoadCredential=admin_token:/etc/africair/secrets/admin_token
LoadCredential=promo_codes:/etc/africair/secrets/promo_codes
LoadCredential=database_url:/etc/africair/secrets/database_url

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M

# Graceful shutdown — must exceed SHUTDOWN_DELAY_MS=5000
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
