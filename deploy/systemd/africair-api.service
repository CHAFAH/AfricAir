[Unit]
Description=AfricAir API (runtime config, secrets, bookings)
Documentation=https://github.com/CHAFAH/AfricAir/blob/main/projects/01-linux-scripting-build-aws/README.md
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/opt/africair/api/current/dist/index.js

[Service]
Type=simple
User=africair
Group=africair
WorkingDirectory=/opt/africair/api/current

# Settings: non-secret, root:africair 0640. build.env (from the artifact) sets GIT_SHA and wins.
EnvironmentFile=/etc/africair/api.env
EnvironmentFile=-/opt/africair/api/current/build.env
Environment=NODE_ENV=production PORT=4000 METRICS_PORT=9464

# Secrets: systemd copies the root-only files into a private, read-only directory ($CREDENTIALS_DIRECTORY,
# %d) that only this service can see. They are copied once, at start: a rotation needs a restart.
LoadCredential=admin_token:/etc/africair/secrets/admin_token
LoadCredential=promo_codes:/etc/africair/secrets/promo_codes
LoadCredential=database_url:/etc/africair/secrets/database_url
Environment=ADMIN_TOKEN_FILE=%d/admin_token PROMO_CODES_FILE=%d/promo_codes DATABASE_URL_FILE=%d/database_url

ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=2

# On SIGTERM the API fails readiness, waits SHUTDOWN_DELAY_MS (5 s), then drains for up to 10 s.
# TimeoutStopSec must exceed both, or systemd SIGKILLs in-flight requests.
KillSignal=SIGTERM
TimeoutStopSec=20

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
InaccessiblePaths=/etc/africair/secrets
MemoryMax=256M

[Install]
WantedBy=multi-user.target
