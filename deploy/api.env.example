# Non-secret settings for /etc/africair/api.env.
# Secrets belong in /etc/africair/secrets and are delivered with LoadCredential.
NODE_ENV=production
PORT=4000
METRICS_PORT=9464
API_HOST=127.0.0.1
METRICS_HOST=127.0.0.1
APP_ENV=staging
APP_VERSION=1.0.0
ANNOUNCEMENT_TEXT=Welcome to the AfricAir staging server
ANNOUNCEMENT_LEVEL=info
SERVICE_FEE_USD=9
DEFAULT_CURRENCY=KES
MAINTENANCE_MODE=false
FEATURE_PROMO_CODES=true
SECRET_REFRESH_SECONDS=10
SHUTDOWN_DELAY_MS=5000
