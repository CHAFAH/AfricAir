# AfricAir API non-secret settings
# Copy to /etc/africair/api.env, owned root:africair, mode 0640
# Secrets are delivered via systemd LoadCredential — do NOT put them here

APP_ENV=staging
APP_VERSION=1.0.0
ANNOUNCEMENT_TEXT=Welcome to the AfricAir staging server
ANNOUNCEMENT_LEVEL=info
SERVICE_FEE_USD=9
DEFAULT_CURRENCY=KES
PORT=4000
METRICS_PORT=9464
SHUTDOWN_DELAY_MS=5000
