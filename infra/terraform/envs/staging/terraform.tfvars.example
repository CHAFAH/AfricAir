# cp terraform.tfvars.example terraform.tfvars, then edit. Nothing in here is secret.
region = "eu-west-1"
team   = "team1"

# Newest EKS version in STANDARD support (1.33 left standard support 14 months after May 2025):
#   aws eks describe-cluster-versions --status STANDARD_SUPPORT --query 'clusterVersions[].clusterVersion'
kubernetes_version = "1.35"

# Your public IP(s): curl -s https://checkip.amazonaws.com
team_cidrs = ["203.0.113.10/32"]
# Who gets cluster admin: your SSO/IAM role ARN (aws sts get-caller-identity → the role, not the session)
admin_principal_arns = ["arn:aws:iam::123456789012:role/AWSReservedSSO_AdministratorAccess_0123456789abcdef"]

# Projects 1-3
owner        = "your-name"
budget_email = "you@example.com"
# ssh_cidrs  = ["203.0.113.10/32"]    # SSH to the Project 1 server; empty = Session Manager only
github_repository = "CHAFAH/AfricAir"
# circleci_org_id     = "00000000-0000-0000-0000-000000000000"   # enables the CircleCI roles
# circleci_project_id = "00000000-0000-0000-0000-000000000000"

# Optional: a domain with a Route 53 hosted zone (HTTPS on the ALB, hosts staging./argocd./grafana.)
# domain_name    = "africair.example.com"
# hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Project 5 hand-over, once Argo CD manages ESO, LBC and Reloader (see gitops/apps/controllers.yaml):
# install_controllers_with_terraform = false
